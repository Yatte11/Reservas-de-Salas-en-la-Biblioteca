# =============================================================================
# Dockerfile.dev — Imagen de desarrollo con nodemon (hot-reload)
# =============================================================================

FROM node:18-alpine

WORKDIR /app

COPY package*.json ./

# Instalar TODAS las dependencias (incluyendo devDependencies)
RUN npm ci

COPY . .

RUN mkdir -p /app/data

ENV NODE_ENV=development
ENV PORT=3000

EXPOSE 3000

CMD ["npm", "run", "dev"]
